<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime, NOT App Sandbox: the app must launch adb / libimobiledevice and
         read Finder backups (MobileSync), which the sandbox forbids. No JIT, no unsigned
         memory, no library-validation exceptions are requested. -->
    <key>com.apple.security.network.client</key><true/>
</dict>
</plist>
